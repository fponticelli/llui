{
  // The example is type-checked in CI (`turbo check`) because its
  // `src/components/ui/` is the CLI's actual output — if `llui add` ever emits
  // something that does not compile, this is where it surfaces. The other
  // examples rely on the vite build alone, which runs the LLui compiler but not
  // a full `tsc`.
  "extends": "../../tsconfig.json",
  "include": ["src"],
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    // The app's OWN copied `src/components/ui/*` never uses `@/` — `llui add`
    // rewrites it to relative imports when no alias is configured (this app
    // has none). This mapping exists only so
    // `src/test-fixtures/navigation-data-live-render.ts` can import
    // `registry/llui/ui/*` SOURCE directly (the scenario renderer under test
    // reaches it the same way `llui add` output would), without adding one
    // for real app code to accidentally rely on.
    "paths": {
      "@/lib/*": ["../../registry/llui/lib/*"],
      "@/ui/*": ["../../registry/llui/ui/*"]
    }
  }
}
