{
  "name": "@llui/example-component-gallery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:baseline": "vite -c vite.baseline.config.ts",
    "dev:registry": "vite -c vite.registry.config.ts",
    "build": "vite build && vite build -c vite.baseline.config.ts && vite build -c vite.registry.config.ts",
    "build:baseline": "vite build -c vite.baseline.config.ts",
    "build:registry": "vite build -c vite.registry.config.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test vite.config.ts vite.baseline.config.ts vite.registry.config.ts vitest.config.ts gallery.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@llui/cli": "workspace:*",
    "@llui/components": "workspace:*",
    "@llui/dom": "workspace:*",
    "tw-animate-css": "^1.0.0"
  },
  "devDependencies": {
    "@llui/vite-plugin": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
