{
  "name": "llui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @llui/mcp test",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "check:benchmarks": "tsc --noEmit -p tsconfig.benchmarks.json",
    "smoke:examples": "tsx scripts/smoke-examples.ts",
    "check:docs": "node scripts/check-readme-examples.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:test-durations": "node scripts/check-test-durations.mjs",
    "test:durations": "node scripts/check-test-durations.mjs --save",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "pnpm format && turbo run build check lint test && pnpm test:scripts && pnpm check:docs && pnpm check:generated && pnpm check:dist",
    "bench": "tsx benchmarks/run-jfb.ts",
    "bench:build": "pnpm --filter js-framework-benchmark-keyed-llui build-prod",
    "bench:setup": "tsx scripts/setup-bench.ts",
    "bench:ticker:setup": "tsx scripts/setup-ticker.ts",
    "bench:ticker": "tsx scripts/run-ticker.ts",
    "bench:all": "tsx scripts/run-bench-all.ts",
    "bench:container": "node scripts/run-bench-container.mjs",
    "bench:container:smoke": "node scripts/run-bench-container.mjs --smoke-image",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,jsx,json,md,css,html,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/runner": "^4.1.2",
    "axe-core": "^4.10.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.5",
    "magic-string": "^0.30.21",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
