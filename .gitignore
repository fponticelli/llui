node_modules
dist
*.tsbuildinfo
.turbo
coverage
benchmarks/js-framework-benchmark-repo/
# Generated on demand by `pnpm bench:ticker:setup` so jfb's framework
# discovery accepts the symlinked apps. Not real lock files.
benchmarks/jfb-ticker/frameworks/*/package-lock.json
# Transient — overwritten on every `pnpm tsx benchmarks/bundle-analyzer.ts` run.
# bundle-baseline.json is the persisted phase history; this is just the latest snapshot.
benchmarks/bundle-composition.json

# Editor workspace settings (peacock, etc.)
.vscode/

# Ephemeral git worktrees created by tooling (EnterWorktree / `git worktree add`).
.claude/worktrees/

# Per-runner temp dir the @llui/mcp `llui_lint` test writes a sample file into
# (needs to live inside the tree so the tool's workspace-containment guard
# accepts it). Suffixed with the test process's PID so two concurrent runs can't
# sweep each other's away; ignored so a run killed mid-test can't pollute
# `git status`.
/tmp-lint-test-*/

# devmode-annotate notebook — developer-local notes/screenshots +
# router chain-state file, not shared across the team unless
# explicitly copied elsewhere.
**/.llui/notes/

# macOS
.DS_Store
