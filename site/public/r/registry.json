    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn / mergeClass",
      "description": "Class-merge helpers. `cn` resolves Tailwind conflicts so a caller override wins; `mergeClass` additionally preserves reactivity when `class` is a Signal, which `cn` alone would stringify to \"[object Object]\".",
      "dependencies": ["@llui/dom", "clsx", "tailwind-merge"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/llui/lib/utils.ts",
          "type": "registry:lib",
          "target": "utils.ts"
        }
      ]
    },
