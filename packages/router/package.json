{
  "name": "@llui/router",
  "version": "0.12.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js"
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@llui/dom": "workspace:^"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@llui/dom": "workspace:*",
    "typescript": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "sideEffects": false,
  "description": "LLui router — named type-safe routes, Standard Schema codecs, history/hash mode",
  "keywords": [
    "llui",
    "router",
    "routing",
    "history",
    "navigation"
  ],
  "author": "Franco Ponticelli <franco.ponticelli@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fponticelli/llui.git",
    "directory": "packages/router"
  },
  "bugs": {
    "url": "https://github.com/fponticelli/llui/issues"
  },
  "homepage": "https://github.com/fponticelli/llui/tree/main/packages/router#readme",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
