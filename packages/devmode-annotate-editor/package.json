{
  "name": "@llui/devmode-annotate-editor",
  "version": "0.1.4",
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@llui/devmode-annotate": "workspace:^",
    "@llui/dom": "workspace:^",
    "@llui/interactions": "workspace:^"
  },
  "dependencies": {
    "@lexical/code-core": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/markdown": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@llui/components": "workspace:^",
    "@llui/lexical": "workspace:^",
    "@llui/markdown": "workspace:^",
    "@llui/markdown-editor": "workspace:^",
    "lexical": "^0.49.0"
  },
  "devDependencies": {
    "@llui/devmode-annotate": "workspace:*",
    "@llui/dom": "workspace:*",
    "@llui/interactions": "workspace:*",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "description": "Rich Markdown editor upgrade for the @llui/devmode-annotate HUD",
  "keywords": [
    "llui",
    "devtools",
    "annotation",
    "markdown",
    "lexical"
  ],
  "author": "Franco Ponticelli <franco.ponticelli@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fponticelli/llui.git",
    "directory": "packages/devmode-annotate-editor"
  },
  "bugs": {
    "url": "https://github.com/fponticelli/llui/issues"
  },
  "homepage": "https://github.com/fponticelli/llui/tree/main/packages/devmode-annotate-editor#readme",
  "publishConfig": {
    "access": "public"
  }
}
